# Separate Top API runs on port 3000; the Next.js dev server uses 3001.
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Local Go API: external. Vercel + Neon: neon (default on Vercel).
API_BACKEND=external
# Cloud only. Secret connection string provided by Neon; NEVER use NEXT_PUBLIC_.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://... (direct connection for migration only)
